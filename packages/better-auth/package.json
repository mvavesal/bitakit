{
  "name": "@bitakit/better-auth",
  "version": "0.2.0",
  "type": "module",
  "bitakit": {
    "plugin": "./plugin",
    "configuration": "better-auth"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./organizations": {
      "types": "./dist/organizations.d.ts",
      "default": "./dist/organizations.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.0",
    "@better-auth/api-key": "1.7.5"
  },
  "peerDependencies": {
    "better-auth": "^1.7.5",
    "react": "^19.0.0",
    "@bitakit/organizations": "^0.2.0",
    "@bitakit/email": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19",
    "@bitakit/organizations": "^0.2.0",
    "@bitakit/email": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@bitakit/organizations": {
      "optional": true
    },
    "@bitakit/email": {
      "optional": true
    }
  },
  "description": "Better Auth plugin, organization adapter and server email callbacks for SaaS Foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/better-auth"
  },
  "publishConfig": {
    "access": "public"
  }
}
