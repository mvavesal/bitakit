{
  "name": "@bitakit/next-intl",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "locales"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preferences": {
      "types": "./dist/preferences.d.ts",
      "default": "./dist/preferences.js"
    },
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bitakit/core": "0.1.0",
    "@bitakit/app-preferences": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "next-intl": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19"
  },
  "description": "next-intl translation plugin for SaaS Foundation."
}
