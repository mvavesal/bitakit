{
  "name": "@bitakit/next-intl",
  "version": "0.2.0",
  "type": "module",
  "bitakit": {
    "plugin": "./plugin"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "locales"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./preferences": {
      "types": "./dist/preferences.d.ts",
      "default": "./dist/preferences.js"
    },
    "./locales/*.json": "./locales/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "next-intl": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19"
  },
  "description": "next-intl translation plugin for SaaS Foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/next-intl"
  },
  "publishConfig": {
    "access": "public"
  }
}
