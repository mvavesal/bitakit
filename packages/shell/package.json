{
  "name": "@bitakit/shell",
  "version": "0.1.0",
  "description": "Optional theme-aware application shell with sidebar and navbar layouts.",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "styles.css",
    "locales"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./dist/settings.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar.d.ts",
      "default": "./dist/sidebar.js"
    },
    "./package.json": "./package.json",
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@bitakit/app-preferences": "0.1.0",
    "@bitakit/core": "0.1.0",
    "@bitakit/ui": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "colorjs.io": "^0.7.1",
    "nuqs": "2.10.1",
    "radix-ui": "^1.6.7",
    "reicon-react": "1.2.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "css.escape": "^1.5.1",
    "jsdom": "^27.4.0",
    "typescript": "^5"
  },
  "foundation": {
    "plugin": "./foundation",
    "configuration": "shell"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/shell"
  },
  "publishConfig": {
    "access": "public"
  }
}
