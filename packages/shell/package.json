{
  "name": "@bitakit/shell",
  "version": "0.2.3",
  "description": "Application frame for BitaKit apps: navigation layouts, slots, appearance settings and notifications.",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "styles.css",
    "locales",
    "examples",
    "themes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./styles.css": "./styles.css",
    "./locales/*.json": "./locales/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/themes.mjs && tsc -p tsconfig.json && node ../../scripts/visual-slot-metadata.mjs shell",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.2",
    "@bitakit/ui": "^0.2.5",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "culori": "^4.0.2",
    "radix-ui": "^1.6.7",
    "react-colorful": "^5.8.1",
    "react-error-boundary": "6.1.6",
    "reicon-react": "1.2.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^19",
    "css.escape": "^1.5.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.28",
    "typescript": "^5"
  },
  "bitakit": {
    "plugin": "./foundation",
    "configuration": "shell",
    "styles": "./styles.css",
    "slots": [
      "app-bar.end",
      "sidebar.header",
      "sidebar.footer"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "layout",
    "navigation",
    "theme"
  ]
}
