{
  "name": "@bitakit/tanstack",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "src/config.mjs",
    "src/config.d.ts",
    "src/cli.mjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "default": "./dist/generated.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    }
  },
  "bin": {
    "foundation-generate": "./src/cli.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.0",
    "@bitakit/ui": "^0.2.0",
    "nuqs": "2.10.1"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.40",
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19"
  },
  "description": "Optional TanStack Router/Start host adapter for Foundation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/tanstack"
  },
  "publishConfig": {
    "access": "public"
  }
}
