{
  "name": "@bitakit/ui",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./theme.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "locales",
    "theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./styles.css": "./styles.css",
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./locales/*.json": "./locales/*.json",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.0",
    "@tanstack/hotkeys": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "radix-ui": "^1.6.7",
    "reicon-react": "1.2.5",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "description": "Foundation React bindings and optional standard themed components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "foundation": {
    "styles": "./styles.css",
    "theme": "./theme.css"
  }
}
