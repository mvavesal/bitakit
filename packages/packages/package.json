{
  "name": "@bitakit/packages",
  "version": "0.2.4",
  "type": "module",
  "description": "Optional trusted package catalogs and recoverable runtime package activation for BitaKit.",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.6",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/npm-package-arg": "^6.1.4",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "npm-package-arg": "^14.0.0",
    "rollup": "^4.66.0",
    "typescript": "^5.9.3",
    "@bitakit/discovery": "^0.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/packages"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "plugins",
    "catalog"
  ],
  "peerDependencies": {
    "esbuild": "^0.28.2",
    "rollup": "^4.66.0",
    "npm-package-arg": "^14.0.0",
    "@bitakit/discovery": "^0.2.5"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "npm-package-arg": {
      "optional": true
    },
    "@bitakit/discovery": {
      "optional": true
    }
  }
}
