{
  "name": "@bitakit/organizations",
  "version": "0.2.5",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "locales",
    "cover.webp"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    },
    "./locales/*.json": "./locales/*.json",
    "./cover.webp": "./cover.webp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.6",
    "tldts": "^7.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  },
  "description": "BitaKit organization contracts, service and demo backend, independent of the auth provider.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/organizations"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "organizations",
    "multi-tenant"
  ],
  "bitakit": {
    "coverImage": "https://cdn.jsdelivr.net/npm/@bitakit/organizations/cover.webp"
  }
