{
  "name": "@bitakit/next",
  "version": "0.2.3",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.5",
    "@bitakit/discovery": "^0.2.3",
    "@bitakit/ui": "^0.2.6",
    "nuqs": "^2.10.1"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0"
  },
  "bin": {
    "foundation-generate": "./src/cli.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^19"
  },
  "description": "Next.js discovery and routing adapter for BitaKit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "nextjs",
    "adapter"
  ]
}
