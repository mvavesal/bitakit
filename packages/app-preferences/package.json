{
  "name": "@bitakit/app-preferences",
  "version": "0.1.0",
  "type": "module",
  "foundation": {
    "discovery": "./discovery",
    "plugin": "./foundation"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "styles.css",
    "discovery.mjs",
    "discovery.d.ts",
    "locales"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "default": "./dist/foundation/index.js"
    },
    "./discovery": {
      "types": "./discovery.d.ts",
      "default": "./discovery.mjs"
    },
    "./styles.css": "./styles.css",
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@bitakit/core": "^0.1.1",
    "@bitakit/ui": "0.1.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@bitakit/core": "^0.1.1",
    "@bitakit/ui": "0.1.0",
    "@types/react": "^19",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@bitakit/core": {
      "optional": true
    },
    "@bitakit/ui": {
      "optional": true
    }
  },
  "dependencies": {
    "radix-ui": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "reicon-react": "1.2.5",
    "@standard-schema/spec": "^1.0.0",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/app-preferences"
  },
  "publishConfig": {
    "access": "public"
  }
}
