{
  "name": "@bitakit/app-preferences",
  "version": "0.2.10",
  "type": "module",
  "description": "The BitaKit settings UI: generated settings pages, field controls, navigation and the settings route.",
  "bitakit": {
    "plugin": "./foundation",
    "styles": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "styles.css",
    "locales"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./styles.css": "./styles.css",
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node ../../scripts/visual-slot-metadata.mjs app-preferences",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.8",
    "@bitakit/ui": "^0.2.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
    "reicon-react": "1.2.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/app-preferences"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "settings",
    "preferences"
  ]
}
