{
  "name": "@bitakit/quick-search",
  "version": "0.2.0",
  "description": "BitaKit Quick Search: a Mod+K dialog that lists pages, Settings pages and plugins.",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "locales"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@bitakit/core": "^0.2.0",
    "@bitakit/ui": "^0.2.0",
    "cmdk": "^1.1.1",
    "reicon-react": "1.2.5"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5",
    "jsdom": "^27.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvavesal/bitakit.git",
    "directory": "packages/quick-search"
  },
  "publishConfig": {
    "access": "public"
  },
  "bitakit": {
    "plugin": "./foundation",
    "configuration": "quick-search",
    "styles": "./styles.css"
  },
  "keywords": [
    "bitakit",
    "ai-agents",
    "composition",
    "search",
    "command-palette"
  ]
}
