{
  "$schema": "https://unpkg.com/@bitakit/shell/dist/theme.schema.json",
  "schemaVersion": 1,
  "id": "sunset",
  "name": "Sunset",
  "shared": { "radius": "0.25rem", "font-sans": "ui-serif, Georgia, serif" },
  "light": {
    "background": "oklch(0.98 0.015 60)",
    "foreground": "oklch(0.25 0.03 40)",
    "card": "oklch(0.995 0.01 60)",
    "card-foreground": "oklch(0.25 0.03 40)",
    "primary": "oklch(0.62 0.17 40)",
    "primary-foreground": "oklch(0.99 0.01 60)",
    "border": "oklch(0.86 0.03 60)",
    "ring": "oklch(0.62 0.17 40)"
  },
  "dark": {
    "background": "oklch(0.2 0.03 40)",
    "foreground": "oklch(0.95 0.02 60)",
    "card": "oklch(0.25 0.03 40)",
    "card-foreground": "oklch(0.95 0.02 60)",
    "primary": "oklch(0.75 0.15 50)",
    "primary-foreground": "oklch(0.2 0.03 40)",
    "border": "oklch(0.35 0.03 40)",
    "ring": "oklch(0.75 0.15 50)"
  }
}
