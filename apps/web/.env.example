# Server-only configuration. Supply your own test database and password locally.
DATABASE_URL=
BETTER_AUTH_SECRET=GENERATE_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For Supabase use sslmode=verify-full and sslrootcert pointing to certs/supabase-ca.crt.

# Server-only key for the public assets bucket (never NEXT_PUBLIC).
SUPABASE_SECRET_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
